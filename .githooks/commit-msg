#!/bin/sh
# commit-msg hook for the ECS781P Plan B Studio repo.
# Rejects any commit whose message or author identity mentions Claude/Anthropic/AI attribution,
# so every commit is attributed only to the team member who did the work.
# Enable once per clone:  git config core.hooksPath .githooks

MSG_FILE="$1"

# Ignore comment lines (starting with #) that git adds to the editor template.
BODY=$(grep -v '^#' "$MSG_FILE")

if printf '%s' "$BODY" | grep -Eiq 'claude|anthropic|co-authored-by|generated with'; then
  echo "ERROR: commit message mentions Claude/Anthropic, 'Generated with', or a Co-Authored-By trailer." >&2
  echo "Remove it and commit again. Commits must be attributed only to the team member who did the work." >&2
  exit 1
fi

AUTHOR=$(git var GIT_AUTHOR_IDENT)
if printf '%s' "$AUTHOR" | grep -Eiq 'claude|anthropic'; then
  echo "ERROR: git author identity looks like Claude/Anthropic: $AUTHOR" >&2
  echo "Set your own identity: git config user.name \"Your Name\" ; git config user.email \"you@example.com\"" >&2
  exit 1
fi

exit 0
